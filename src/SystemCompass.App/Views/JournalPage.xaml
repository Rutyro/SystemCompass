<Page
    x:Class="SystemCompass.App.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SystemCompass.App.ViewModels">

    <Grid Padding="32,24,32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Journal" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Append-only record of every change. A verified change can be rolled back to the state recorded before it was applied."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Button Grid.Row="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Left" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:JournalRowViewModel">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind TimeLabel}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind EntryName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ActionLabel}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind StatusLabel}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="4"
                                Content="Roll back"
                                IsEnabled="{x:Bind CanRollback}"
                                Click="OnRollbackClick" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar
            Grid.Row="3"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
