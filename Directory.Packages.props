    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
    <PackageVersion Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>
</Project>
