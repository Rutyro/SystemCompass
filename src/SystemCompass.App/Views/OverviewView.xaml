<UserControl
    x:Class="SystemCompass.App.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SystemCompass.App.Controls"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <DataTemplate x:Key="LegendTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="3" Text="{Binding PercentLabel}" Style="{StaticResource Caption}" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="{Binding ValueLabel}" Style="{StaticResource Caption}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Fraction}"
                             Foreground="{Binding Brush}" Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="Auditing startup entries...">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,18,22,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="16" Padding="26" Background="{StaticResource HeroGradientBrush}"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY OVERVIEW" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#BFDBFE" Margin="0,0,0,8" />
                            <TextBlock Text="Your startup, at a glance" FontSize="29" FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding AuditSummary}" FontSize="13" Foreground="#C7D2FE" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding HygieneSummary}" FontSize="13" Foreground="#E0E7FF"
                                       Margin="0,4,0,0" MaxWidth="620" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Refresh audit" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SoftButton}" Margin="0,0,8,0" />
                                <Button Content="Open startup" Command="{Binding OpenStartupCommand}"
                                        Style="{StaticResource SoftButton}" Margin="0,0,8,0" />
                                <Button Content="Tune settings" Command="{Binding OpenTweaksCommand}"
                                        Style="{StaticResource SoftButton}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="190" Height="190" HorizontalAlignment="Right">
                            <controls:DonutChart Slices="{Binding ScoreSlices}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Width="190" Height="190" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="{Binding ScoreLabel}" FontSize="38" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" />
                            <TextBlock Text="hygiene score" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#2234D399" Margin="0,0,10,0">
                                    <TextBlock Text="▶" FontSize="14" Foreground="{StaticResource AccentGreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EnabledLabel}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="Enabled at startup" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="7,0,7,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#22FBBF24" Margin="0,0,10,0">
                                    <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RecommendationsLabel}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="Recommendations" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="7,0,7,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#22A78BFA" Margin="0,0,10,0">
                                    <TextBlock Text="◆" FontSize="13" Foreground="{StaticResource AccentVioletBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProtectedLabel}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="Protected" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="7,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#2260A5FA" Margin="0,0,10,0">
                                    <TextBlock Text="≡" FontSize="16" Foreground="{StaticResource AccentBlueBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="Curated tweaks" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Startup composition" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Where the audited entries classify by purpose and risk."
                                       Style="{StaticResource Caption}" Margin="0,3,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="170" Height="170">
                                    <controls:DonutChart Slices="{Binding CategorySlices}" TrackBrush="#16FFFFFF" />
                                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding TotalEntriesLabel}" FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="entries" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CategorySlices}"
                                              ItemTemplate="{StaticResource LegendTemplate}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Startup mechanisms" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Run keys, folders, tasks, services and logon hooks."
                                       Style="{StaticResource Caption}" Margin="0,3,0,12" />
                            <ItemsControl ItemsSource="{Binding MechanismBars}" ItemTemplate="{StaticResource BarTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Signature trust" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Authenticode result for every startup entry."
                                       Style="{StaticResource Caption}" Margin="0,3,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="170" Height="170">
                                    <controls:DonutChart Slices="{Binding SignatureSlices}" TrackBrush="#16FFFFFF" />
                                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding UnsignedLabel}" FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="unsigned" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SignatureSlices}"
                                              ItemTemplate="{StaticResource LegendTemplate}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Catalog coverage" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding CatalogCaption}" Style="{StaticResource Caption}" Margin="0,3,0,12" />
                            <ItemsControl ItemsSource="{Binding CatalogBars}" ItemTemplate="{StaticResource BarTemplate}" />
                            <Expander Header="How the hygiene score is calculated" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="The score starts at 100 and subtracts for enabled recommendations, unclear entries, unsigned entries and invalid signatures. It is an orientation aid, not a security audit." />
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Review next" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding RecommendationCaption}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <xctk:IntegerUpDown Value="{Binding TopRecommendations, Mode=TwoWay}"
                                                        Minimum="1" Maximum="10" Width="64" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecommendationRows}" Margin="0,10,0,0"
                                          Visibility="{Binding RecommendationsVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nothing to review. Every recommendation is already disabled."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding EmptyRecommendationsVisibility}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Change activity" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open journal" Command="{Binding OpenJournalCommand}"
                                        Style="{StaticResource SoftButton}" />
                            </Grid>
                            <controls:BarSparkline Height="54" Margin="0,10,0,0"
                                                   Values="{Binding ActivityValues}"
                                                   BarBrush="{StaticResource AccentBlueBrush}" />
                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="{Binding ActivityRange}" Style="{StaticResource Faint}" />
                                <TextBlock Text="Today" Style="{StaticResource Faint}" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentChanges}" Visibility="{Binding RecentChangesVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding EntryName}"
                                                       Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                                       Style="{StaticResource Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No changes have been recorded yet."
                                       Style="{StaticResource Caption}"
                                       Visibility="{Binding EmptyJournalVisibility}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </xctk:BusyIndicator>
</UserControl>
