<Window
    x:Class="SystemCompass.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="SystemCompass settings"
    Width="620"
    Height="560"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Appearance">
                <StackPanel Margin="14">
                    <GroupBox Header="Theme">
                        <StackPanel>
                            <RadioButton x:Name="DarkTheme" Content="Dark (recommended)" IsChecked="True"
                                         Checked="OnThemeChanged" Margin="0,0,0,6" />
                            <RadioButton x:Name="LightTheme" Content="Light" Checked="OnThemeChanged" />
                            <TextBlock Text="AvalonDock keeps the Visual Studio dark theme in both modes."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Chart accent">
                        <StackPanel Orientation="Horizontal">
                            <xctk:ColorPicker x:Name="AccentPicker" Width="140"
                                              Background="{StaticResource SubtleBrush}"
                                              ButtonStyle="{StaticResource DarkColorPickerButton}"
                                              SelectedColorChanged="OnAccentChanged"
                                              DisplayColorAndName="False" ShowStandardColors="True" />
                            <TextBlock Text="Used by the activity bars." Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Redaction">
                <StackPanel Margin="14">
                    <TextBlock Text="Additional terms" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Every word or phrase entered here is replaced with &lt;REDACTED&gt; in reports generated after you apply it."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,8" />
                    <xctk:TokenizedTextBox x:Name="TermsBox" MinHeight="34" Padding="6"
                                           TokenDelimiter=",;" Background="{StaticResource SubtleBrush}" />
                    <TextBlock Text="Separate terms with commas or semicolons. The list is kept for this session only."
                               Style="{StaticResource Faint}" Margin="0,4,0,0" />
                    <Button Content="Apply terms to the redactor" Click="OnApplyTerms"
                            Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Layout">
                <StackPanel Margin="14">
                    <GroupBox Header="Panels">
                        <StackPanel>
                            <TextBlock Text="Explorer, Properties and the bottom panes are AvalonDock anchorables. Drag them to float, dock or auto-hide; the layout is saved on close."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <Button Content="Reset to the default layout" Click="OnResetLayout"
                                    Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="About this window">
                        <TextBlock Text="Settings are local. No network call is made and no telemetry is sent."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="OnClose" Width="90" />
        </StackPanel>
    </Grid>
</Window>
