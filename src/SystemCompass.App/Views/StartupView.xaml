<UserControl
    x:Class="SystemCompass.App.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Startup" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every entry found by the audit. Protected entries cannot be changed. Every change is read back from the system and journaled."
                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding TotalCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                    <TextBlock Text="entries" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding EnabledCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                    <TextBlock Text="enabled" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding RecommendationCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                    <TextBlock Text="recommendations" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentVioletBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ProtectedCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                    <TextBlock Text="protected" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding FilteredCountLabel}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <xctk:WatermarkTextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                   Watermark="Search name, publisher or command" Padding="7,5" />
            <ComboBox Grid.Column="1" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" Margin="8,0,0,0">
                <ComboBoxItem Content="All categories" />
                <ComboBoxItem Content="Disable recommended" />
                <ComboBoxItem Content="Optional" />
                <ComboBoxItem Content="Unclear" />
                <ComboBoxItem Content="Keep" />
                <ComboBoxItem Content="Security relevant" />
            </ComboBox>
            <CheckBox Grid.Column="2" Content="Include system entries" IsChecked="{Binding IncludeSystem}"
                      VerticalAlignment="Center" Margin="12,0" />
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SoftButton}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="StartupList" ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      SelectionChanged="OnSelectionChanged"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Padding" Value="4,5" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy command line" Click="OnCopyPath" />
                        <MenuItem Header="Open file location" Click="OnOpenLocation" />
                        <Separator />
                        <MenuItem Header="Show in Control Center" Click="OnShowTweaks" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="30">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource TrimmedCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Category" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryLabel}" ToolTip="{Binding CategoryLabel}" Style="{StaticResource TrimmedCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Mechanism" Width="105">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MechanismLabel}" ToolTip="{Binding MechanismLabel}" Style="{StaticResource TrimmedCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Signer" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SignatureLabel}" ToolTip="{Binding SignatureLabel}" Style="{StaticResource TrimmedCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="State" Width="65" DisplayMemberBinding="{Binding StateLabel}" />
                        <GridViewColumn Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanToggle}"
                                            Visibility="{Binding ToggleVisibility}"
                                            Click="OnToggleClick" Padding="8,2" Style="{StaticResource SoftButton}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Expander Grid.Row="1" Header="Selected entry details" Margin="0,8,0,0" IsExpanded="False">
                <Border Style="{StaticResource CardBorder}" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEntry.Name}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding SelectedEntry.MetaLabel}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <TextBlock Text="Command line" Style="{StaticResource Faint}" />
                            <xctk:AutoSelectTextBox Text="{Binding SelectedEntry.Detail, Mode=OneWay}"
                                                     IsReadOnly="True" Background="{StaticResource SubtleBrush}"
                                                     Padding="6" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="Why the audit classified it this way" Style="{StaticResource Faint}" />
                            <TextBox Text="{Binding SelectedEntry.Entry.Assessment.Reason, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource SubtleBrush}"
                                     BorderThickness="0" Padding="6" Margin="0,2,0,0" MinHeight="60" />
                            <TextBlock Text="{Binding SelectedEntry.ProtectionReason}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
