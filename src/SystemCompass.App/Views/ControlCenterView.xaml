<UserControl
    x:Class="SystemCompass.App.Views.ControlCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Control Center" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every operation captures the previous value, is verified by reading the system back and can be reverted. Security-protected settings are refused by the engine."
                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel MinWidth="86">
                    <TextBlock Text="{Binding AppliedCountLabel}" Style="{StaticResource MetricValue}" />
                    <TextBlock Text="applied" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="Catalog state" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FilteredCountLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Maximum="1" Value="{Binding AppliedFraction}" Margin="0,5,0,4"
                                 Foreground="{StaticResource AccentGreenBrush}" />
                    <TextBlock Text="Partial means some operations match and some do not. A failed read-back is never reported as applied."
                               Style="{StaticResource Faint}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Style="{StaticResource ChipBorder}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AppliedCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBlock Text="applied" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorder}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentAmberBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PartialCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBlock Text="partial" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotAppliedCountLabel}" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBlock Text="not applied" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <xctk:WatermarkTextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"
                                   Watermark="Search title, category or id" Padding="7,5" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryFilterIndex}"
                      Margin="8,0,0,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusFilterIndex}"
                      Margin="8,0,0,0" />
            <xctk:CheckComboBox Grid.Column="3" ItemsSource="{Binding RiskOptions}" SelectedItemsOverride="{Binding RiskFilters}"
                                Margin="8,0,0,0" />
            <CheckBox Grid.Column="4" Content="Only selected" IsChecked="{Binding OnlySelected}"
                      VerticalAlignment="Center" Margin="10,0" />
            <Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SoftButton}" />
        </Grid>

        <xctk:BusyIndicator Grid.Row="3" IsBusy="{Binding IsBusy}" BusyContent="Reading the catalog...">
            <ListBox x:Name="TweakList" ItemsSource="{Binding Tweaks}"
                     SelectedItem="{Binding SelectedTweak, Mode=TwoWay}"
                     SelectionChanged="OnSelectionChanged"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource SubtleBrush}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeBorder}" Background="{Binding RiskBrush}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding BadgeLabel}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeBorder}" Background="{Binding StatusBrush}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="#111111" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0" />
                                    <Expander Header="{Binding OperationCountLabel}" Margin="24,6,0,0">
                                        <ItemsControl ItemsSource="{Binding OperationLines}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Apply" IsEnabled="{Binding CanApply}" Visibility="{Binding ApplyVisibility}" Click="OnApplyClick"
                                            Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                                    <Button Content="Revert" IsEnabled="{Binding CanRevert}" Visibility="{Binding RevertVisibility}" Click="OnRevertClick"
                                            Style="{StaticResource SoftButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </xctk:BusyIndicator>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding CatalogWarning}" Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasCatalogWarning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
