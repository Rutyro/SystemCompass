<Page
    x:Class="SystemCompass.App.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24,32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Report" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Diagnostics and startup summary. Exports are redacted: user names, profile paths, machine names, SIDs and non-system drive paths never leave the app."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Content="Generate" Command="{x:Bind ViewModel.GenerateCommand}" />
            <Button Content="Save to Documents" Command="{x:Bind ViewModel.SaveCommand}" />
            <Button Content="Copy" Command="{x:Bind ViewModel.CopyCommand}" />
            <ToggleSwitch
                OnContent="Demo data"
                OffContent="Live data"
                IsOn="{x:Bind ViewModel.UseDemo, Mode=TwoWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>

        <TextBox
            Grid.Row="2"
            Text="{x:Bind ViewModel.ReportText, Mode=OneWay}"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <InfoBar
            Grid.Row="3"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
